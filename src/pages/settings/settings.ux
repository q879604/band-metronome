<template>
  <div class="page">
    <div class="hdr">
      <text class="title">设置</text>
      <text class="sub">{{ strengthText }}</text>
    </div>

    <scroll class="body" scroll-y="true">
      <div class="grp">
        <text class="grpname">速度来源</text>
        <div class="valrow">
          <text class="valname">{{ speedModeText }}</text>
          <text class="valtext">{{ speedValueText }}</text>
        </div>
        <div class="row">
          <div class="kbtn" onclick="setBpmMode"><text class="kbtntext">按 BPM</text></div>
          <div class="kbtn" onclick="setGapMode"><text class="kbtntext">按间隔 ms</text></div>
        </div>
        <div class="row">
          <div class="kbtn" onclick="speedMinus5"><text class="kbtntext">{{ sm5Text }}</text></div>
          <div class="kbtn" onclick="speedPlus5"><text class="kbtntext">{{ sp5Text }}</text></div>
        </div>
        <div class="row">
          <div class="kbtn" onclick="speedMinus1"><text class="kbtntext">{{ sm1Text }}</text></div>
          <div class="kbtn" onclick="speedPlus1"><text class="kbtntext">{{ sp1Text }}</text></div>
        </div>
        <text class="note">按间隔 = 直接填每拍多少毫秒，和社区那些震动 App 一个口径</text>
      </div>

      <div class="grp">
        <text class="grpname">振动时长</text>
        <div class="valrow">
          <text class="valname">设定</text>
          <text class="valtext">{{ vibMs }} ms</text>
        </div>
        <text class="note">{{ burstText }}</text>
        <div class="row">
          <div class="kbtn" onclick="vibMinus"><text class="kbtntext">-20</text></div>
          <div class="kbtn" onclick="vibPlus"><text class="kbtntext">+20</text></div>
        </div>
        <text class="note">9 Pro 只有长/短两档，时长靠连击凑（和米环9「环间跳蛋」同款做法）</text>
      </div>

      <div class="grp">
        <text class="grpname">连击步长（震感细腻度）</text>
        <div class="valrow">
          <text class="valname">步长</text>
          <text class="valtext">{{ stepMs }} ms</text>
        </div>
        <div class="row">
          <div class="kbtn" onclick="stepMinus"><text class="kbtntext">-10</text></div>
          <div class="kbtn" onclick="stepPlus"><text class="kbtntext">+10</text></div>
        </div>
        <text class="note">越小越连续（马达一直转），越大越像一下一下的点；越小越费电</text>
      </div>

      <div class="grp">
        <text class="grpname">振动类型</text>
        <div class="valrow">
          <text class="valname">当前</text>
          <text class="valtext">{{ vibModeText }}</text>
        </div>
        <div class="row">
          <div class="kbtn" onclick="modeShort"><text class="kbtntext">短振动</text></div>
          <div class="kbtn" onclick="modeLong"><text class="kbtntext">长振动</text></div>
        </div>
      </div>

      <div class="grp">
        <text class="grpname">首拍重音（时长翻倍）</text>
        <div class="valrow">
          <text class="valname">当前</text>
          <text class="valtext">{{ accentText }}</text>
        </div>
        <div class="row">
          <div class="kbtn" onclick="accentOn"><text class="kbtntext">开</text></div>
          <div class="kbtn" onclick="accentOff"><text class="kbtntext">关</text></div>
        </div>
      </div>

      <div class="grp">
        <text class="grpname">震动引擎</text>
        <div class="valrow">
          <text class="valname">当前</text>
          <text class="valtext">{{ engineText }}</text>
        </div>
        <div class="row">
          <div class="kbtn" onclick="setBeat"><text class="kbtntext">逐拍震动</text></div>
          <div class="kbtn" onclick="setNative"><text class="kbtntext">原生任务</text></div>
        </div>
        <text class="note">逐拍 = vibrator.vibrate，全机型可用（手环 9 Pro 只能这样）</text>
        <text class="note">原生任务 = vibrator.start，官方只给 Xiaomi Watch S5 实现，不支持会自动回退</text>
      </div>

      <div class="grp">
        <text class="grpname">启动后的屏幕</text>
        <div class="valrow">
          <text class="valname">当前</text>
          <text class="valtext">{{ policyText }}</text>
        </div>
        <div class="row">
          <div class="kbtn" onclick="policyDim"><text class="kbtntext">最低亮度</text></div>
          <div class="kbtn" onclick="policyKeep"><text class="kbtntext">保持常亮</text></div>
        </div>
        <div class="row">
          <div class="kbtn" onclick="policySystem"><text class="kbtntext">跟随系统</text></div>
          <div class="kbtn" onclick="beatsUnlimited"><text class="kbtntext">拍数不限</text></div>
        </div>
        <text class="note">最低亮度：启动即最暗 + 常亮，连点 5 次屏幕恢复原亮度</text>
      </div>

      <div class="grp">
        <text class="grpname">拍数上限</text>
        <div class="valrow">
          <text class="valname">到达后自动停</text>
          <text class="valtext">{{ maxBeatsText }}</text>
        </div>
        <div class="row">
          <div class="kbtn" onclick="beatsMinus"><text class="kbtntext">-20</text></div>
          <div class="kbtn" onclick="beatsPlus"><text class="kbtntext">+20</text></div>
        </div>
      </div>

      <div class="grp">
        <text class="grpname">震动强度</text>
        <text class="note">当前 {{ strengthText }}；9 Pro 未实现读取/设置，应用无法单独调速</text>
        <text class="note">改强度：手环「设置 → 振动强度」或小米运动健康里调</text>
      </div>

      <div class="grp">
        <text class="grpname">本机能力自检</text>
        <text class="note">{{ selfTestText }}</text>
        <div class="row">
          <div class="kbtn" onclick="testVibShort"><text class="kbtntext">试震-短</text></div>
          <div class="kbtn" onclick="testVibLong"><text class="kbtntext">试震-长</text></div>
        </div>
        <div class="row">
          <div class="kbtn" onclick="testCurrent"><text class="kbtntext">试当前设置</text></div>
          <div class="kbtn" onclick="testNative"><text class="kbtntext">测原生任务</text></div>
        </div>
        <div class="row">
          <div class="kbtn" onclick="back"><text class="kbtntext">返回</text></div>
        </div>
      </div>
    </scroll>
  </div>
</template>

<style>
  @import "../../common/theme.css";
</style>

<script>
  import router from '@system.router';
  import vibrator from '@system.vibrator';
  import storage from '@system.storage';
  import {
    sanitize,
    periodMsOf,
    beatModeOf,
    burstCountOf,
    actualVibMsOf,
    LIMITS,
    clampInt
  } from '../../common/metronome';

  const KEY = 'metronome.settings';

  export default {
    private: {
      speedModeText: '按 BPM',
      speedValueText: '60',
      sm5Text: '-5',
      sp5Text: '+5',
      sm1Text: '-1',
      sp1Text: '+1',
      vibMs: 60,
      burstText: '',
      stepMs: 40,
      vibModeText: '短振动',
      accentText: '关',
      engineText: '逐拍震动',
      policyText: '最低亮度',
      maxBeatsText: '不限',
      strengthText: '强度：-',
      selfTestText: '点下面按钮自检本机能力'
    },

    s: null,
    burstTimer: null,
    burstLeft: 0,

    onInit() {
      storage.get({
        key: KEY,
        success: (d) => {
          this.apply(this.parse(d));
        },
        fail: () => {
          this.apply(null);
        }
      });
      this.readStrength();
    },

    onDestroy() {
      if (this.burstTimer) {
        clearTimeout(this.burstTimer);
        this.burstTimer = null;
      }
    },

    parse(d) {
      if (!d) return null;
      if (typeof d === 'string') {
        try {
          return JSON.parse(d);
        } catch (e) {
          return null;
        }
      }
      if (typeof d === 'object' && d.value) return this.parse(d.value);
      return typeof d === 'object' ? d : null;
    },

    apply(raw) {
      this.s = sanitize(raw);
      this.refresh();
    },

    refresh() {
      const s = this.s;
      const period = periodMsOf(s);
      if (s.speedMode === 'gap') {
        this.speedModeText = '按间隔 ms';
        this.speedValueText = period + ' ms / 拍';
        this.sm5Text = '-50';
        this.sp5Text = '+50';
        this.sm1Text = '-10';
        this.sp1Text = '+10';
      } else {
        this.speedModeText = '按 BPM';
        this.speedValueText = s.bpm + ' 拍 / 分';
        this.sm5Text = '-5';
        this.sp5Text = '+5';
        this.sm1Text = '-1';
        this.sp1Text = '+1';
      }
      this.vibMs = s.vibMs;
      this.stepMs = s.burstStep;
      this.burstText =
        '设为 ' + s.vibMs + 'ms → 每拍连击 ' + burstCountOf(s, 2) + ' 次，实际震 ' + actualVibMsOf(s, 2) + 'ms';
      this.vibModeText = s.vibMode === 'long' ? '长振动' : '短振动';
      this.accentText = s.accent ? '开（第 1 拍时长翻倍）' : '关';
      this.engineText = s.engine === 'native' ? '原生任务' : '逐拍震动';
      this.policyText =
        s.policy === 'dim' ? '最低亮度' : s.policy === 'keep' ? '保持常亮' : '跟随系统';
      this.maxBeatsText = s.maxBeats > 0 ? s.maxBeats + ' 拍' : '不限';
    },

    save() {
      storage.set({ key: KEY, value: JSON.stringify(this.s) });
    },

    commit() {
      this.save();
      this.refresh();
    },

    readStrength() {
      try {
        const m = vibrator.getSystemDefaultMode();
        const names = ['关闭振动', '标准振动', '加强振动'];
        this.strengthText = typeof m === 'number' && names[m] ? '强度：' + names[m] : '强度：本机不支持读取';
      } catch (e) {
        // 手环 9/9 Pro 未实现 getSystemDefaultMode（官方支持明细：仅 Xiaomi Watch S5）
        this.strengthText = '强度：本机不支持读取';
      }
    },

    /* ---------- 速度 ---------- */

    setBpmMode() {
      this.s.speedMode = 'bpm';
      this.commit();
    },
    setGapMode() {
      this.s.speedMode = 'gap';
      this.commit();
    },
    adjustSpeed(delta) {
      const s = this.s;
      if (s.speedMode === 'gap') s.gapMs = clampInt(s.gapMs + delta, LIMITS.gapMs[0], LIMITS.gapMs[1]);
      else s.bpm = clampInt(s.bpm + delta, LIMITS.bpm[0], LIMITS.bpm[1]);
      this.commit();
    },
    speedMinus5() {
      this.adjustSpeed(this.s.speedMode === 'gap' ? -50 : -5);
    },
    speedPlus5() {
      this.adjustSpeed(this.s.speedMode === 'gap' ? 50 : 5);
    },
    speedMinus1() {
      this.adjustSpeed(this.s.speedMode === 'gap' ? -10 : -1);
    },
    speedPlus1() {
      this.adjustSpeed(this.s.speedMode === 'gap' ? 10 : 1);
    },

    /* ---------- 时长 / 步长 / 类型 ---------- */

    vibMinus() {
      this.s.vibMs = clampInt(this.s.vibMs - 20, LIMITS.vibMs[0], LIMITS.vibMs[1]);
      this.commit();
    },
    vibPlus() {
      this.s.vibMs = clampInt(this.s.vibMs + 20, LIMITS.vibMs[0], LIMITS.vibMs[1]);
      this.commit();
    },
    stepMinus() {
      this.s.burstStep = clampInt(this.s.burstStep - 10, LIMITS.burstStep[0], LIMITS.burstStep[1]);
      this.commit();
    },
    stepPlus() {
      this.s.burstStep = clampInt(this.s.burstStep + 10, LIMITS.burstStep[0], LIMITS.burstStep[1]);
      this.commit();
    },
    modeShort() {
      this.s.vibMode = 'short';
      this.commit();
    },
    modeLong() {
      this.s.vibMode = 'long';
      this.commit();
    },
    accentOn() {
      this.s.accent = true;
      this.commit();
    },
    accentOff() {
      this.s.accent = false;
      this.commit();
    },

    /* ---------- 引擎 / 屏幕 / 拍数 ---------- */

    setBeat() {
      this.s.engine = 'vibrate';
      this.commit();
    },
    setNative() {
      this.s.engine = 'native';
      this.commit();
    },
    policyDim() {
      this.s.policy = 'dim';
      this.commit();
    },
    policyKeep() {
      this.s.policy = 'keep';
      this.commit();
    },
    policySystem() {
      this.s.policy = 'system';
      this.commit();
    },
    adjustBeats(delta) {
      let n = this.s.maxBeats + delta;
      if (n < LIMITS.maxBeats[0]) n = LIMITS.maxBeats[0];
      if (n > LIMITS.maxBeats[1]) n = LIMITS.maxBeats[1];
      if (n > 0 && n < 20) n = 20;
      this.s.maxBeats = n;
      this.commit();
    },
    beatsMinus() {
      this.adjustBeats(-20);
    },
    beatsPlus() {
      this.adjustBeats(20);
    },
    beatsUnlimited() {
      this.s.maxBeats = 0;
      this.commit();
    },

    /* ---------- 自检 ---------- */

    vibrateOnce(mode) {
      try {
        vibrator.vibrate({ mode: mode });
      } catch (e) {
        this.selfTestText = 'vibrate 调用异常：' + e;
      }
    },

    testVibShort() {
      this.vibrateOnce('short');
      this.selfTestText = '已发短振动（系统标准档）';
    },

    testVibLong() {
      this.vibrateOnce('long');
      this.selfTestText = '已发长振动（系统加强档）';
    },

    /** 按当前设置连击，验证「时长」手感 */
    testCurrent() {
      const n = burstCountOf(this.s, 1);
      const total = actualVibMsOf(this.s, 1);
      this.burstLeft = n;
      this.burstFire();
      this.selfTestText = '按当前设置连击 ' + n + ' 次，约 ' + total + 'ms';
    },

    burstFire() {
      if (this.burstLeft <= 0) {
        this.burstTimer = null;
        return;
      }
      this.burstLeft = this.burstLeft - 1;
      this.vibrateOnce(beatModeOf(this.s));
      if (this.burstLeft > 0) {
        this.burstTimer = setTimeout(() => {
          this.burstFire();
        }, this.s.burstStep);
      } else {
        this.burstTimer = null;
      }
    },

    /** 实测 vibrator.start 在本机到底有没有实现 */
    testNative() {
      let done = false;
      this.selfTestText = '正在测原生任务…';
      try {
        vibrator.start({
          duration: this.s.vibMs,
          interval: 200,
          count: 2,
          success: (d) => {
            done = true;
            this.selfTestText = 'start 可用，任务 id=' + (d && d.id != null ? d.id : '?');
          },
          fail: (data, code) => {
            done = true;
            this.selfTestText = 'start 不支持（错误码 ' + code + '）';
          }
        });
      } catch (e) {
        this.selfTestText = 'start 直接抛异常 → 本机未实现';
      }
      setTimeout(() => {
        if (!done) this.selfTestText = 'start 无任何回调 → 本机未实现';
      }, 900);
    },

    back() {
      router.back();
    }
  };
</script>