{
  "package": "io.github.q879604.metronome",
  "name": "节拍器",
  "versionName": "0.1.0",
  "versionCode": 1,
  "minPlatformVersion": 1200,
  "icon": "/common/icon.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.router"
    },
    {
      "name": "system.device"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.prompt"
    },
    {
      "name": "system.vibrator"
    },
    {
      "name": "system.brightness"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": "device-width"
  },
  "display": {
    "backgroundColor": "#000000"
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      },
      "pages/settings": {
        "component": "settings"
      }
    }
  }
}